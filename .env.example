# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=rag_corpus_v1

# Crawler
CRAWL_START_URL=https://cdac.gov.in/
CRAWL_ALLOWED_DOMAIN=cdac.gov.in

# Embeddings and retrieval
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_MODE=hybrid
KB_SOURCE=all

# Optional LLM configuration (leave unset for the mock provider)
LLM_PROVIDER=mock
LLM_MODEL=mentor-provided-model
